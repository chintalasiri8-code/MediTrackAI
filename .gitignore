# Exclude nested Git repositories in subfolders (prevents submodule conflicts)
frontend/.git/
backend/.git/
*.git_standalone/
.git_standalone

# Frontend dependencies & build artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Backend build artifacts
backend/target/
*.class

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime Medical Uploads (Exclude all medical PDFs & documents, allow .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Environment and Secret files
.env
.env.*
!.env.example

# IDE & Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
Thumbs.db
